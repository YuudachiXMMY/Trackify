# ============================================================
# Trackify — Local Development Environment
# Port range: 3500–3599 (Web 3500 | API 3501 | DB 3502)
# Copy to .env.local:  cp .env.example .env.local
# ============================================================

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_DB=trackify
POSTGRES_USER=trackify
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=3502

# ── Prisma (host-side, for CLI commands) ─────────────────────
DATABASE_URL=postgresql://trackify:changeme@localhost:3502/trackify

# ── API ──────────────────────────────────────────────────────
API_PORT=3501
API_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3500
JWT_SECRET=dev-jwt-secret-change-in-production

# ── Web ──────────────────────────────────────────────────────
WEB_PORT=3500
VITE_API_BASE_URL=http://localhost:3501

# ── Traefik (optional, for domain-based routing) ─────────────
WEB_DOMAIN=trackify.localhost
API_DOMAIN=api.trackify.localhost

# ── Seed user (filled automatically by db:seed) ─────────────
# VITE_SEED_USER_ID=
