# ============================================
# Trackify Local Development Environment
# ============================================

# PostgreSQL (docker compose service)
POSTGRES_DB=trackify
POSTGRES_USER=trackify
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_PORT=5432

# Prisma / API database connection
# From host: postgresql://user:pass@localhost:5432/trackify
# From api container: postgresql://user:pass@postgres:5432/trackify
DATABASE_URL=postgresql://trackify:change_me_postgres@localhost:5432/trackify

# API
API_PORT=3010
API_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=change_me_jwt_secret_at_least_32_chars

# Web
VITE_API_BASE_URL=http://localhost:3010
VITE_SEED_USER_ID=
WEB_PORT=5173
